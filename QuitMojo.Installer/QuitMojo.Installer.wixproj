<Project Sdk="WixToolset.Sdk/4.0.5" InitialTargets="PublishAppForInstaller">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <InstallerLanguage Condition="'$(InstallerLanguage)' == ''">en</InstallerLanguage>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(InstallerLanguage)\</IntermediateOutputPath>
    <InstallerLcid Condition="'$(InstallerLanguage)' == 'uk'">1058</InstallerLcid>
    <InstallerLcid Condition="'$(InstallerLanguage)' != 'uk'">1033</InstallerLcid>
    <InstallerLaunchCheckboxText Condition="'$(InstallerLanguage)' == 'uk'">Запустити QuitMojo після завершення інсталяції</InstallerLaunchCheckboxText>
    <InstallerLaunchCheckboxText Condition="'$(InstallerLanguage)' != 'uk'">Launch QuitMojo after setup finishes</InstallerLaunchCheckboxText>
    <InstallerShortcutDescription Condition="'$(InstallerLanguage)' == 'uk'">QuitMojo</InstallerShortcutDescription>
    <InstallerShortcutDescription Condition="'$(InstallerLanguage)' != 'uk'">QuitMojo</InstallerShortcutDescription>
    <InstallerDowngradeError Condition="'$(InstallerLanguage)' == 'uk'">Новіша версія QuitMojo уже встановлена.</InstallerDowngradeError>
    <InstallerDowngradeError Condition="'$(InstallerLanguage)' != 'uk'">A newer version of QuitMojo is already installed.</InstallerDowngradeError>
    <OutputName>QuitMojo-$(InstallerLanguage)-$(Version)-x64</OutputName>
    <PublishDir>$(MSBuildThisFileDirectory)artifacts\publish\</PublishDir>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);QuitMojoVersion=$(Version);QuitMojoManufacturer=$(Company);QuitMojoProductName=$(Product);QuitMojoDescription=$(Description);InstallerLanguage=$(InstallerLanguage);InstallerLcid=$(InstallerLcid);InstallerLaunchCheckboxText=$(InstallerLaunchCheckboxText);InstallerShortcutDescription=$(InstallerShortcutDescription);InstallerDowngradeError=$(InstallerDowngradeError)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <Target Name="PublishAppForInstaller">
    <RemoveDir Directories="$(PublishDir)" />
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="dotnet publish &quot;..\QuitMojo\QuitMojo.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(PublishDir)&quot;" />
  </Target>

</Project>